{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Personalized Kisan-SPO user profile and onboarding state (PII isolated in private subcollection).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Authenticated user UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Full name or FPO representative name",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "description": "Selected operational workspace role preference",
          "enum": ["farmer", "agent", "buyer"]
        },
        "villageOrOrg": {
          "type": "string",
          "description": "Combined village or organization display label",
          "minLength": 1,
          "maxLength": 120
        },
        "village": {
          "type": "string",
          "description": "Village name (optional, empty string if skipped)",
          "minLength": 0,
          "maxLength": 80
        },
        "district": {
          "type": "string",
          "description": "District name (optional, empty string if skipped)",
          "minLength": 0,
          "maxLength": 80
        },
        "state": {
          "type": "string",
          "description": "State name (optional, empty string if skipped)",
          "minLength": 0,
          "maxLength": 80
        },
        "preferredLanguage": {
          "type": "string",
          "description": "Bilingual UI preference",
          "enum": ["en", "hi"]
        },
        "onboardingStatus": {
          "type": "string",
          "description": "Whether first-time onboarding is incomplete, completed, or skipped",
          "enum": ["INCOMPLETE", "COMPLETED", "SKIPPED"]
        },
        "onboardingStep": {
          "type": "number",
          "description": "Current onboarding wizard step (1 to 4)"
        },
        "profileCompletion": {
          "type": "number",
          "description": "Profile setup completion percentage (0 to 100)"
        },
        "isDemoAccount": {
          "type": "boolean",
          "description": "Whether this profile belongs to the isolated demonstration dataset"
        },
        "demoDatasetVersion": {
          "type": "string",
          "description": "Version tag for demonstration dataset",
          "minLength": 0,
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was last updated"
        }
      },
      "required": [
        "uid",
        "displayName",
        "role",
        "villageOrOrg",
        "village",
        "district",
        "state",
        "preferredLanguage",
        "onboardingStatus",
        "onboardingStep",
        "profileCompletion",
        "isDemoAccount",
        "demoDatasetVersion",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII record containing user email, optional phone number, and verification metadata.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Authenticated user UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Authenticated user email address",
          "minLength": 3,
          "maxLength": 254
        },
        "phoneNumber": {
          "type": "string",
          "description": "Optional phone number supplied during onboarding or profile edit",
          "minLength": 0,
          "maxLength": 24
        },
        "emailVerified": {
          "type": "boolean",
          "description": "Whether the email is verified by the identity provider"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the latest sync"
        }
      },
      "required": ["uid", "email", "phoneNumber", "emailVerified", "updatedAt"]
    },
    "CropLotRecord": {
      "title": "CropLotRecord",
      "description": "Persistent Digital Crop Passport and verification state for an agricultural lot scoped to its owner.",
      "type": "object",
      "properties": {
        "lotId": {
          "type": "string",
          "description": "Unique crop lot identifier",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the creator/owner",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "shortCode": {
          "type": "string",
          "description": "Short display code for the lot",
          "minLength": 1,
          "maxLength": 32
        },
        "farmerName": {
          "type": "string",
          "description": "Farmer display name",
          "minLength": 1,
          "maxLength": 120
        },
        "cropName": {
          "type": "string",
          "description": "Commodity name",
          "minLength": 1,
          "maxLength": 120
        },
        "variety": {
          "type": "string",
          "description": "Crop variety name",
          "minLength": 1,
          "maxLength": 120
        },
        "quantityQuintals": {
          "type": "number",
          "description": "Declared lot weight in quintals"
        },
        "verificationStatus": {
          "type": "string",
          "description": "Current verification tier",
          "enum": [
            "INDEPENDENTLY_VERIFIED",
            "LABORATORY_TESTED",
            "DOCUMENT_VERIFIED",
            "FARMER_DECLARED",
            "VERIFICATION_PENDING"
          ]
        },
        "sha256Hash": {
          "type": "string",
          "description": "Cryptographic SHA-256 evidence digest",
          "minLength": 16,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp"
        }
      },
      "required": [
        "lotId",
        "ownerId",
        "shortCode",
        "farmerName",
        "cropName",
        "variety",
        "quantityQuintals",
        "verificationStatus",
        "sha256Hash",
        "createdAt",
        "updatedAt"
      ]
    },
    "AuditEvent": {
      "title": "AuditEvent",
      "description": "Immutable administrative or operational audit log entry.",
      "type": "object",
      "properties": {
        "actorUid": {
          "type": "string",
          "description": "UID of the user performing the action",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorRole": {
          "type": "string",
          "description": "Role at time of action",
          "enum": ["farmer", "agent", "buyer", "admin"]
        },
        "action": {
          "type": "string",
          "description": "Action code",
          "minLength": 1,
          "maxLength": 80
        },
        "target": {
          "type": "string",
          "description": "Target entity ID",
          "minLength": 1,
          "maxLength": 128
        },
        "reason": {
          "type": "string",
          "description": "Documented reason for the event",
          "minLength": 1,
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "description": "Outcome of the action",
          "enum": ["SUCCESS", "DENIED", "WARNING"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the event"
        }
      },
      "required": [
        "actorUid",
        "actorRole",
        "action",
        "target",
        "reason",
        "status",
        "createdAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator membership document.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Admin UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when admin access was granted"
        }
      },
      "required": ["uid", "grantedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Personalized user profile and onboarding documents keyed by Firebase Auth UID"
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII subcollection storing email, optional phone number, and verification metadata"
    },
    "/cropLots/{lotId}": {
      "schema": { "$ref": "#/entities/CropLotRecord" },
      "description": "User-scoped Digital Crop Passport and verification state documents"
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditEvent" },
      "description": "Immutable operational and administrative audit trail records"
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted administrator registry collection"
    }
  }
}
