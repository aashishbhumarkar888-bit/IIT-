# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# KISAN_SESSION_SECRET: HMAC-SHA256 secret used by server.ts to sign session tokens.
KISAN_SESSION_SECRET="REPLACE_WITH_HIGH_ENTROPY_SESSION_SECRET"

# ADMIN_EMAIL & ADMIN_PASSWORD_SALT / ADMIN_PASSWORD_HASH:
# Configure production administrator credentials on the server.
# Never expose administrator secrets in VITE_ client variables.
ADMIN_EMAIL="admin@kisan-spo.org.in"
ADMIN_PASSWORD_HASH=""

# Optional Firebase / Identity Provider client configuration:
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""

