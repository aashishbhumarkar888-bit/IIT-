# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# KISAN_SESSION_SECRET: Stable HMAC-SHA256 key for stateless 15-minute server tokens.
# Production must provide a random secret of at least 32 characters; use the same
# value on every Cloud Run instance. Do not use this placeholder value.
KISAN_SESSION_SECRET="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"

# ADMIN_EMAIL & ADMIN_PASSWORD_SALT / ADMIN_PASSWORD_HASH:
# Configure production administrator credentials on the server.
# Never expose administrator secrets in VITE_ client variables.
ADMIN_EMAIL="admin@kisan-spo.org.in"
ADMIN_PASSWORD_HASH=""

# Optional Firebase / Identity Provider client configuration:
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""

# Enable live Crop-to-Cash REST API v1 (/api/v1/lots/*) integration:
VITE_CROP_TO_CASH_API_ENABLED="true"

